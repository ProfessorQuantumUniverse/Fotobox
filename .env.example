# Fotobox – Konfiguration (nach .env kopieren und anpassen)
# cp .env.example .env

# Share-Modus: "hotspot" (lokales WLAN + Download-Galerie) oder "nextcloud"
FOTOBOX_SHARE_MODE=hotspot

# --- Nextcloud (nur bei FOTOBOX_SHARE_MODE=nextcloud nötig) ---
# Unbedingt ein App-Passwort verwenden (Einstellungen > Sicherheit > Geräte & Sitzungen)
FOTOBOX_NC_URL=
FOTOBOX_NC_USER=
FOTOBOX_NC_PASS=
FOTOBOX_NC_FOLDER=Fotobox
FOTOBOX_NC_TIMEOUT=10

# --- Hardware ---
FOTOBOX_SERIAL_PORT=/dev/ttyUSB0
FOTOBOX_SERIAL_BAUD=9600

# --- Speicher & Server ---
FOTOBOX_PHOTO_DIR=/home/fotobox/photos
FOTOBOX_HOST=0.0.0.0
FOTOBOX_PORT=5000

# Kontroll-Endpoints (Kiosk-UI, Trigger, Session) von anderen Geräten erlauben?
# Nur zum Entwickeln auf 1 setzen – Gäste könnten sonst Fotos auslösen!
FOTOBOX_ALLOW_REMOTE_CONTROL=0

# --- Anzeige ---
# Auto-Reset des Review-Screens (Sekunden, 0 = aus)
FOTOBOX_REVIEW_SECONDS=30
# Auto-Reset des QR-Screens (Sekunden, 0 = aus)
FOTOBOX_QR_TIMEOUT_SECONDS=120
# Max. Kantenlänge der Vorschaubilder (Pi 3: 1280 ist ein guter Wert)
FOTOBOX_PREVIEW_MAX_SIZE=1280

# --- USB-Stick-Backup ---
# Steckt ein USB-Stick im Pi, wird JEDES Foto (auch abgebrochene Sessions)
# zusätzlich darauf gesichert, solange der Stick steckt. Ein Toast meldet das
# Ein- und Ausstecken. 0 = aus.
FOTOBOX_USB_BACKUP=1
# Wo nach gemounteten Sticks gesucht wird (Doppelpunkt-getrennt).
FOTOBOX_USB_MOUNT_ROOTS=/media:/mnt
# Zielordner auf dem Stick.
FOTOBOX_USB_BACKUP_SUBDIR=Fotobox
# Takt (Sekunden), in dem auf Ein-/Ausstecken geprüft wird. 0 = aus.
FOTOBOX_USB_POLL=3

# --- Updates (werden nur ANGEBOTEN, nie automatisch installiert) ---
# Gibt es neue Commits auf dem Git-Remote, zeigt der Kiosk eine antippbare
# Toast. Installiert wird erst nach Eingabe dieser PIN am Bildschirm.
FOTOBOX_UPDATE_PIN=5050
# Takt (Sekunden), in dem auf Updates geprüft wird (git fetch). 0 = aus.
FOTOBOX_UPDATE_CHECK_INTERVAL=300

# --- Hotspot ---
FOTOBOX_AP_IFACE=wlan0
FOTOBOX_AP_CONNECTION_NAME=fotobox-ap
FOTOBOX_AP_IP=10.42.0.1
